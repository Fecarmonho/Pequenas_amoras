rules_version = '2';

// Todo o acesso ao Firestore deste projeto passa pelo servidor (Next.js
// API routes + Server Components), usando o Admin SDK — que ignora estas
// regras de propósito. Nenhum código do navegador fala com o Firestore
// diretamente (só com o Firebase Auth, pra login). Por isso aqui é
// "negar tudo": se algum dia o app do navegador tentar ler/escrever
// direto, ou se alguém abrir o console e tentar usar a config pública do
// projeto, a regra barra — o isolamento por responsável (guardianIds)
// que o código do servidor garante não existe aqui, então sem essa
// barreira qualquer um poderia ler/escrever a coleção inteira.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
